# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM -----------------------------------------------------------------
# MOCK_LLM=true swaps the classifier for a keyword router and the writer for
# a slot-filled template, so the whole system runs offline. Keep it true
# until the real path is wired, and keep it working after that -- it is how
# the eval set runs for free, and how the demo survives the venue wifi.
MOCK_LLM=true
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# --- Data and store ------------------------------------------------------
DATA_DIR=data/primary
DUCKDB_PATH=rng.duckdb

# --- Service -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
